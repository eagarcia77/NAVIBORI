# Owned application origin (HTTPS in production; no path/query/fragment).
# Required on Netlify. Set to the exact assigned site URL before building.
# Also register /auth/callback and /auth/callback?flow=merchant in Supabase.
# Local development only:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NAVIBORI Supabase project
# Use the modern publishable key. Never place a secret/service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
